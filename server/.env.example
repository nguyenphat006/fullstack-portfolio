# Django Core Settings
# Bắt buộc khi DEBUG=False. Tạo khóa ngẫu nhiên:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=dev-only-change-me-portfolio
# Tài khoản quản trị đầu tiên (seed_core / bootstrap). Bắt buộc ADMIN_PASSWORD khi DEBUG=False.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Dev: True. Production: False (mặc định trong code là False)
DEBUG=True

# --- Chỉ dùng khi DEBUG=False (production sau reverse proxy HTTPS) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://erp.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==============================================================================
# DATABASE — chỉ hỗ trợ PostgreSQL (nhật ký thao tác dùng django-pghistory / pgtrigger)
# ==============================================================================
# Mặc định: Postgres của docker-compose (`docker compose up -d db redis`), Django chạy trên máy.
#   Django chạy trong container (`docker compose up`) -> host là `db` thay cho 127.0.0.1.
#   Windows đã cài sẵn PostgreSQL (service chiếm cổng 5432) -> kết nối trúng nhầm server, báo sai mật khẩu:
#   dừng service đó, hoặc đổi cổng map của `db` trong docker-compose.yml (vd 55432:5432) và sửa cổng dưới đây.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/portfolio_db

# Hoặc Postgres trên cloud (Neon: console.neon.tech):
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require

# ==============================================================================
# CORS Configuration (Frontend Next.js URL)
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Token Lifetime
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ==============================================================================
# Celery & Redis Task Queue Configuration
# ==============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Cache dùng chung giữa các process (RBAC permission cache). Bỏ trống -> LocMemCache.
REDIS_CACHE_URL=redis://localhost:6379/1
# Tiền tố khóa cache (mặc định = tên CSDL). Nhiều dự án dùng chung 1 Redis phải khác nhau.
# CACHE_KEY_PREFIX=app

# Unit test chạy trên Postgres local (docker-compose), không dùng Neon.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/portfolio_db
