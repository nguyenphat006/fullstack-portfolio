{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python manage.py check*)",
      "Bash(python manage.py makemigrations*)",
      "Bash(python manage.py showmigrations*)",
      "Bash(./venv/Scripts/python.exe manage.py check*)",
      "Bash(./venv/Scripts/python.exe manage.py makemigrations*)",
      "Bash(antd info *)",
      "Bash(antd demo *)",
      "Bash(antd doc *)",
      "Bash(antd token *)",
      "Bash(antd semantic *)",
      "Bash(antd lint *)",
      "Bash(npm run build)",
      "Bash(npm run lint)"
    ],
    "deny": [
      "Read(./server/.env)",
      "Read(./client/.env.local)"
    ]
  }
}
