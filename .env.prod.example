# Biến môi trường cho docker-compose.prod.yml — copy thành .env.prod (KHÔNG commit .env.prod)
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Django — tạo khóa: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=erp.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://erp.example.com
# Đặt True khi đã có HTTPS phía trước nginx
SECURE_SSL_REDIRECT=False

# PostgreSQL (container db)
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=

# Tài khoản quản trị đầu tiên (tạo 1 lần, không ghi đè về sau)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cổng public của nginx
HTTP_PORT=80
GUNICORN_WORKERS=3
