# Base API URL của Django Backend (cổng 8000, version 1)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Landing page: form liên hệ gửi mail qua Gmail (Server Action + Nodemailer)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Khóa cho /api/revalidate (backend gọi sau khi lưu nội dung) — đặt giống REVALIDATE_SECRET ở backend
REVALIDATE_SECRET=
# Domain thật của landing (canonical, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=https://ericss.id.vn
